<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.studentgradesystem.ViewReportsController">

    <children>

        <Label layoutX="167.0" layoutY="47.0" text="Student Grade System" underline="true">
            <font>
                <Font size="23.0" />
            </font>
        </Label>

        <Label layoutX="252.0" layoutY="96.0" text="Report">
            <font>
                <Font size="16.0" />
            </font>
        </Label>

        <Label layoutX="119.0" layoutY="153.0" text="Total Students:">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <Label layoutX="118.0" layoutY="184.0" text="Average Grade:">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <Label layoutX="119.0" layoutY="221.0" text="Highest Grade:">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <Label layoutX="121.0" layoutY="257.0" text="Lowest Grade:">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <!-- Dynamic labels -->
        <Label fx:id="lblTotal" layoutX="220.0" layoutY="153.0" text="0" />
        <Label fx:id="lblAverage" layoutX="220.0" layoutY="184.0" text="0" />
        <Label fx:id="lblHighest" layoutX="220.0" layoutY="221.0" text="0" />
        <Label fx:id="lblLowest" layoutX="220.0" layoutY="257.0" text="0" />

        <!-- Back Button -->
        <Button layoutX="256.0" layoutY="334.0" mnemonicParsing="false" onAction="#goBack" style="-fx-background-color: #BFDBFE;" text="Back">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>

    </children>

</AnchorPane>
