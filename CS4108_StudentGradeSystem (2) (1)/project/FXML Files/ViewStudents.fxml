<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="640.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.studentgradesystem.ViewStudentsController">

    <children>

        <AnchorPane VBox.vgrow="ALWAYS">

            <children>

                <Label layoutX="173.0" layoutY="37.0"
                       text="Student Grade System"
                       underline="true">
                    <font>
                        <Font size="23.0" />
                    </font>
                </Label>

                <Label layoutX="251.0" layoutY="93.0"
                       text="View Students">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <TableView fx:id="tableStudent"
                           layoutX="186.0"
                           layoutY="136.0"
                           prefHeight="199.0"
                           prefWidth="217.0">

                    <columns>
                        <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="75.0" text="Name" />
                        <TableColumn fx:id="colGrade" prefWidth="75.0" text="Grade" />
                    </columns>

                </TableView>

                <Button layoutX="186.0" layoutY="361.0"
                        mnemonicParsing="false"
                        onAction="#goNext"
                        style="-fx-background-color: #BFDBFE;"
                        text="Next">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button layoutX="363.0" layoutY="361.0"
                        mnemonicParsing="false"
                        onAction="#goBack"
                        style="-fx-background-color: #BFDBFE;"
                        text="Back">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

            </children>

        </AnchorPane>

    </children>

</VBox>